// ApexFund — Prisma schema
// Prop-trading challenge platform data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  TRADER
  ADMIN
  SUPER_ADMIN
}

enum PhaseType {
  PHASE_1
  PHASE_2
  FUNDED
}

enum PhaseStatus {
  PENDING
  ACTIVE
  PASSED
  FAILED
  FUNDED
  SUSPENDED
  PENDING_PAYOUT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
  AVAILABLE
}

enum TradeSide {
  LONG
  SHORT
}

enum RiskEventType {
  DAILY_LOSS_BREACH
  MAX_LOSS_BREACH
  PROFIT_TARGET_HIT
  MIN_DAYS_MET
  MANUAL_ADJUSTMENT
}

enum CouponType {
  PERCENT
  FIXED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(TRADER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  accounts      Account[]
  orders        Order[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
}

// A ChallengeTemplate defines the purchasable product & its rule-set.
// All numeric business rules are admin-configurable here — never hardcoded
// in application logic.
model ChallengeTemplate {
  id          String  @id @default(cuid())
  name        String
  accountSize Int // in account currency units, e.g. 10000
  priceCents  Int // list price in cents (USD)
  active      Boolean @default(true)

  // Phase 1 (Challenge) rules
  phase1ProfitTargetPct Decimal @default(10) @db.Decimal(6, 3)
  phase1MinTradingDays  Int     @default(4)

  // Phase 2 (Verification) rules
  phase2ProfitTargetPct Decimal @default(5) @db.Decimal(6, 3)
  phase2MinTradingDays  Int     @default(4)

  // Shared risk limits across phase 1 / phase 2 / funded
  maxDailyLossPct   Decimal @default(5) @db.Decimal(6, 3)
  maxOverallLossPct Decimal @default(10) @db.Decimal(6, 3)

  // Funded stage
  profitSplitTraderPct Decimal @default(80) @db.Decimal(5, 2)

  // Daily reset time (UTC, "HH:mm") used by the risk engine for day boundaries
  dailyResetTimeUtc String @default("00:00")

  // Payout center configuration (admin-configurable per template).
  minPayoutCents  Int @default(3000)
  payoutCycleDays Int @default(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  coupons  Coupon[]
  orders   Order[]

  @@index([accountSize])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2) // percent (0-100) or fixed cents depending on `type`
  active         Boolean    @default(true)
  maxRedemptions Int?
  timesRedeemed  Int        @default(0)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())

  // Optionally restrict a coupon to a specific template; null = applies to all
  templateId String?
  template   ChallengeTemplate? @relation(fields: [templateId], references: [id])

  orders Order[]
}

model Order {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  templateId String
  template   ChallengeTemplate @relation(fields: [templateId], references: [id])
  couponId   String?
  coupon     Coupon?           @relation(fields: [couponId], references: [id])

  subtotalCents Int
  discountCents Int         @default(0)
  totalCents    Int
  status        OrderStatus @default(PENDING)

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  agreedToRulesAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?
  account Account?

  @@index([userId])
  @@index([status])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  amountCents Int
  status      PaymentStatus @default(PENDING)
  provider    String        @default("stripe")
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// An Account is one purchased challenge instance belonging to a trader.
model Account {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  templateId String
  template   ChallengeTemplate @relation(fields: [templateId], references: [id])
  orderId    String?           @unique
  order      Order?            @relation(fields: [orderId], references: [id])

  startingBalanceCents Int
  currentBalanceCents  Int // realized balance (closed trades only)
  currentEquityCents   Int // balance + open/floating P/L

  highestBalanceCents Int // running high-water mark, used for overall-loss calc
  dayStartEquityCents Int // equity/balance snapshot at the most recent daily reset
  dayStartAt          DateTime @default(now())

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases     ChallengePhase[]
  trades     Trade[]
  riskEvents RiskEvent[]
  payouts    Payout[]

  @@index([userId])
}

model ChallengePhase {
  id        String      @id @default(cuid())
  accountId String
  account   Account     @relation(fields: [accountId], references: [id])
  type      PhaseType
  status    PhaseStatus @default(ACTIVE)

  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  tradingDays Int       @default(0)

  // Snapshot of the rules that applied to this phase at start time, so that
  // later admin edits to the template do not retroactively change history.
  profitTargetPct   Decimal @db.Decimal(6, 3)
  maxDailyLossPct   Decimal @db.Decimal(6, 3)
  maxOverallLossPct Decimal @db.Decimal(6, 3)
  minTradingDays    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
}

model Trade {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])
  symbol          String
  side            TradeSide
  volume          Decimal   @db.Decimal(12, 4)
  openPrice       Decimal   @db.Decimal(18, 6)
  closePrice      Decimal?  @db.Decimal(18, 6)
  openedAt        DateTime
  closedAt        DateTime?
  pnlCents        Int? // realized P/L once closed; null while open
  commissionCents Int       @default(0)
  swapCents       Int       @default(0)

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([openedAt])
}

model Payout {
  id               String       @id @default(cuid())
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id])
  amountCents      Int
  traderShareCents Int
  firmShareCents   Int
  status           PayoutStatus @default(PENDING)
  requestedAt      DateTime     @default(now())
  processedAt      DateTime?
  notes            String?
  rejectionReason  String?

  @@index([accountId])
  @@index([status])
}

model RiskEvent {
  id        String        @id @default(cuid())
  accountId String
  account   Account       @relation(fields: [accountId], references: [id])
  type      RiskEventType
  message   String
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([accountId])
  @@index([type])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(INFO)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}

// Generic key/value runtime settings (branding, feature flags, etc.)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
