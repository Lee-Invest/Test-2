# --- Database ---------------------------------------------------------
# Matches the credentials in docker-compose.yml (run `docker compose up -d`
# for a zero-signup local Postgres). Swap for a hosted connection string
# (Neon, Supabase, etc.) when deploying.
DATABASE_URL="postgresql://apexfund:apexfund@localhost:5432/apexfund"

# --- NextAuth (Auth.js) ------------------------------------------------
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (test mode) -------------------------------------------------
STRIPE_SECRET_KEY="sk_test_51exampleXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_WEBHOOK_SECRET="whsec_exampleXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_PUBLISHABLE_KEY="pk_test_51exampleXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# --- Email (dev: logged to console, prod: wire up nodemailer) ---------
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="ApexFund <no-reply@apexfund.example>"
